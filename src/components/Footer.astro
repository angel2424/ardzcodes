---
const year = new Date().getFullYear()
---

<footer class="bg-brand-100 dark:bg-brand-900" data-footer>
  <div class="mx-auto max-w-7xl px-8 py-24">
    <h2 class="font-heading text-brand-700 text-4xl font-extrabold dark:text-slate-100">
      arod.dev
    </h2>

    <div class="mt-20 flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-center">
      <p class="dark:text-brand-300 text-sm font-light text-slate-600">
        Copyright {year} © arod.dev. All rights reserved
      </p>

      <div class="flex items-center gap-4">
        <a
          class="hover:text-brand-500 text-slate-900 transition duration-300 dark:text-slate-100"
          href="https://www.instagram.com/arod.dev/"
          target="_blank"
          rel="noreferrer"
          aria-label="Instagram"
        >
          <i class="fa-brands fa-instagram text-xl" aria-hidden="true"></i>
        </a>
        <a
          class="hover:text-brand-500 text-slate-900 transition duration-300 dark:text-slate-100"
          href="https://github.com/angel2424"
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub"
        >
          <i class="fa-brands fa-github text-xl" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </div>
</footer>
