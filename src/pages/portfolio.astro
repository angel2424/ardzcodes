---
import BaseLayout from '../layouts/BaseLayout.astro'
import Projects from '../components/landing/Projects.astro'
import type { Lang } from '../i18n/translations'
import { useTranslations } from '../i18n/translations'

const lang = (Astro.currentLocale ?? 'en') as Lang
const t = useTranslations(lang)
---

<BaseLayout title="arod.dev - Portfolio" description="Portfolio projects built by arod.dev">
  <main class="relative z-10">
    <section class="mx-auto max-w-7xl px-8 pt-40 pb-0 lg:pt-64">
      <h1
        class="font-heading text-brand-900 text-5xl font-extrabold lg:text-6xl dark:text-slate-100"
      >
        Portfolio
      </h1>
      <p
        class="text-brand-800 dark:text-brand-300 mt-3 text-xl leading-snug font-normal tracking-wide"
      >
        {t.portfolio.text}
      </p>
    </section>

    <Projects showAll={true} showTitle={false} />
  </main>
</BaseLayout>
